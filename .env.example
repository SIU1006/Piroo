BROKER_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-me-dev-only
WHISPER_URL=http://localhost:3000
LLM_MODEL=llama3.2
# Compose runs S3-compatible MinIO; direct host development can explicitly use local.
UPLOAD_STORAGE_BACKEND=s3
S3_UPLOAD_BUCKET=asyncvtp-uploads
# For direct host use, port-forward MinIO or expose its port on localhost.
S3_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=dev-only-minio
AWS_SECRET_ACCESS_KEY=dev-only-minio-password
MAX_OUTSTANDING_TASKS=100
TASK_QUEUE_TIMEOUT_SECONDS=600
UPLOAD_TIMEOUT_SECONDS=120
